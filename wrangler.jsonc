{
  // Cloudflare Workers config for the OpenNext build of the exchange web app.
  "name": "exchange-web-app",
  "routes": [{ "pattern": "app.interstate.so", "custom_domain": true }],
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
