# Turnkey Configuration
# Get your organization ID from https://app.turnkey.com
NEXT_PUBLIC_TURNKEY_ORGANIZATION_ID=

# Turnkey API Base URL (leave as is)
NEXT_PUBLIC_TURNKEY_API_BASE_URL=https://api.turnkey.com

# Your backend server endpoint for Turnkey signing
NEXT_PUBLIC_TURNKEY_SERVER_SIGN_URL=http://localhost:8000/api/turnkey

# Google OAuth Configuration
# Get this from https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID and add http://localhost:3000 to authorized origins
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Add your other existing environment variables below
# Copy from your old .env file if you have one
